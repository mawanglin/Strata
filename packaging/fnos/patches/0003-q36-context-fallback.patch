+/** fnOS package: did the last start of the Qwen3.6 engine stop for lack of VRAM? Read from the engine's own log (the run config's "log"), from
+ *  the last "engine started" line on, so an older start's lines never count. false when there is no such stop (or no readable log), else
+ *  {slots, eachGib, freeGib}: for a stop of several sessions the engine names their count and size ("not enough VRAM for 2 slots at a context
+ *  of N (X GiB each, Y GiB free)"), otherwise slots is 0. */
+export function q36VramStop(logPath){
+ if(typeof logPath!=='string'||!logPath)return false;
+ let text='';
+ try{text=readFileSync(logPath,'utf8');}catch{return false;}
+ const at=text.lastIndexOf('engine started:');
+ const run=(at>=0?text.slice(at):text).slice(-65536);
+ if(!/strata-q36:[^\n]*(out of memory|not enough VRAM)/i.test(run))return false;
+ const m=run.match(/not enough VRAM for (\d+) slots at a context of \d+ \(([\d.]+) GiB each, ([\d.]+) GiB free\)/);
+ return m?{slots:Number(m[1]),eachGib:Number(m[2]),freeGib:Number(m[3])}:{slots:0,eachGib:0,freeGib:0};
+}
